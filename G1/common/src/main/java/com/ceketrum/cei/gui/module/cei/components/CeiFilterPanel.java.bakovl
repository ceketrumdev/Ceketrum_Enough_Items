package com.ceketrum.cei.gui.module.cei.components;

import com.ceketrum.cei.gui.constants.GuiConstants;
import com.ceketrum.cei.i18n.CeiText;

import java.util.ArrayList;
import java.util.LinkedHashSet;
import java.util.List;
import java.util.Map;
import java.util.Set;
import java.util.TreeMap;

import net.minecraft.client.gui.DrawContext;
import net.minecraft.text.Text;
import net.minecraft.registry.Registries;
import net.minecraft.item.ItemStack;

/**
 * Bouton "Filtres" et son panneau deroulant.
 *
 * Le panneau ne flotte pas au-dessus de la liste : il la POUSSE vers le bas.
 * C'est ce qui permet de reutiliser le defilement existant sans rien
 * superposer, et de garder un seul endroit ou la liste commence --
 * getItemsListStartY() ajoute simplement la hauteur rendue ici.
 *
 * La geometrie des lignes est MEMORISEE au rendu et relue au clic. Recalculer
 * la meme chose des deux cotes finit toujours par diverger d'un pixel, et on
 * coche alors la ligne d'a cote.
 */
public class CeiFilterPanel {

    /** Une case a cocher : la valeur filtree, son libelle, son effectif. */
    private static final class Entry {
        final String key;
        final String label;
        final int count;
        Entry(String key, String label, int count) {
            this.key = key;
            this.label = label;
            this.count = count;
        }
    }

    public static final int BUTTON_H = 16;
    private static final int ROW_H = 11;
    private static final int MAX_ROWS = 8;
    private static final int PAD = 4;

    private boolean open = false;
    private final Set<String> selectedMods = new LinkedHashSet<>();
    private final List<Entry> mods = new ArrayList<>();
    private boolean built = false;
    private int scroll = 0;

    /** Geometrie du dernier rendu, relue telle quelle par le clic. */
    private int btnX, btnY, btnW;
    private int listX, listY, listW;
    private int rowsShown;

    // ------------------------------------------------------------- donnees

    /**
     * Construit la liste des mods presents, une seule fois.
     *
     * L'effectif est affiche a cote du nom : sans lui, une liste de quarante
     * mods ne dit pas lesquels pesent dans l'inventaire.
     */
    public void build(List<ItemStack> allItems) {
        if (built) return;
        built = true;
        Map<String, Integer> byMod = new TreeMap<>();
        for (ItemStack stack : allItems) {
            try {
                var id = Registries.ITEM.getId(stack.getItem());
                if (id != null) byMod.merge(id.getNamespace(), 1, Integer::sum);
            } catch (Exception e) {
                // une pile invalide ne doit pas priver le joueur du panneau
            }
        }
        for (Map.Entry<String, Integer> e : byMod.entrySet()) {
            mods.add(new Entry(e.getKey(), e.getKey(), e.getValue()));
        }
    }

    /** A appeler quand la liste d'items change de fond. */
    public void invalidate() {
        built = false;
        mods.clear();
        scroll = 0;
    }

    /**
     * Un item passe-t-il les filtres ?
     *
     * Aucun mod coche = aucun filtre. Plusieurs mods coches = l'un OU l'autre :
     * cocher deux mods sert a les comparer, pas a chercher les items qui
     * seraient dans les deux -- il n'y en a jamais.
     */
    public boolean accepts(ItemStack stack) {
        if (selectedMods.isEmpty()) return true;
        try {
            var id = Registries.ITEM.getId(stack.getItem());
            return id != null && selectedMods.contains(id.getNamespace());
        } catch (Exception e) {
            return true;
        }
    }

    public boolean isActive() {
        return !selectedMods.isEmpty();
    }

    public int activeCount() {
        return selectedMods.size();
    }

    // ---------------------------------------------------------- geometrie

    /**
     * Hauteur occupee sous la rangee de boutons.
     *
     * Zero quand le panneau est ferme : la liste d'items remonte alors
     * exactement ou elle etait.
     */
    public int expandedHeight() {
        if (!open) return 0;
        int rows = Math.min(MAX_ROWS, Math.max(1, mods.size()));
        return rows * ROW_H + PAD * 2 + ROW_H;   // + une ligne pour "tout effacer"
    }

    // ------------------------------------------------------------- rendu

    public void render(DrawContext context, int x, int y, int width,
                       int panelX, int panelWidth,
                       net.minecraft.client.font.TextRenderer textRenderer, double mouseX, double mouseY) {
        btnX = x; btnY = y; btnW = width;

        String label = CeiText.t("gui.cei.filters");
        if (!selectedMods.isEmpty()) label = label + " (" + selectedMods.size() + ")";
        boolean hovered = mouseX >= x && mouseX < x + width
                && mouseY >= y && mouseY < y + BUTTON_H;

        context.fill(x, y, x + width, y + BUTTON_H,
                (open || isActive()) ? 0xFF3A3A3A : (hovered ? 0xFF343434 : 0xFF2C2C2C));
        context.drawBorder(x, y, width, BUTTON_H, GuiConstants.BORDER_COLOR);

        String shown = trim(textRenderer, label, width - 8);
        context.drawText(textRenderer, Text.literal(shown),
                x + (width - textRenderer.getWidth(shown)) / 2,
                y + (BUTTON_H - textRenderer.fontHeight) / 2, 0xFFFFFFFF, false);

        if (!open) return;

        listX = panelX + 5;
        listW = panelWidth - 10;
        listY = y + BUTTON_H + 2;

        int h = expandedHeight() - 2;
        context.fill(listX, listY, listX + listW, listY + h, 0xE8141414);
        context.drawBorder(listX, listY, listW, h, GuiConstants.BORDER_COLOR);

        // "Tout effacer" en tete : c'est l'action qu'on cherche quand on ne
        // comprend plus ce que la liste affiche.
        int rowY = listY + PAD;
        boolean clearHover = inRow(mouseX, mouseY, rowY);
        context.drawText(textRenderer, Text.literal(
                        (isActive() ? "\u00a7f" : "\u00a78") + CeiText.t("gui.cei.filters.clear")),
                listX + 5, rowY + 1, clearHover ? 0xFFFFFFFF : 0xFFAAAAAA, false);
        rowY += ROW_H;

        rowsShown = Math.min(MAX_ROWS, Math.max(0, mods.size() - scroll));
        for (int i = 0; i < rowsShown; i++) {
            Entry entry = mods.get(scroll + i);
            boolean on = selectedMods.contains(entry.key);
            boolean hov = inRow(mouseX, mouseY, rowY);

            if (hov) context.fill(listX + 1, rowY, listX + listW - 1, rowY + ROW_H, 0x33FFFFFF);

            // La case est dessinee, pas ecrite : un caractere de case a cocher
            // n'est garanti par aucune police, et un pack de ressources peut le
            // remplacer par n'importe quoi.
            int bx = listX + 5, by = rowY + 1;
            context.fill(bx, by, bx + 8, by + 8, on ? 0xFFFFFFFF : 0xFF3A3A3A);
            context.drawBorder(bx, by, 8, 8, 0x66FFFFFF);
            if (on) context.fill(bx + 2, by + 2, bx + 6, by + 6, 0xFF141414);

            String count = " \u00a78(" + entry.count + ")";
            int room = listW - 22 - textRenderer.getWidth(count);
            context.drawText(textRenderer,
                    Text.literal(trim(textRenderer, entry.label, room) + count),
                    bx + 12, rowY + 1, on ? 0xFFFFFFFF : 0xFFBBBBBB, false);
            rowY += ROW_H;
        }

        // Indicateur de reste : sans lui, rien ne dit qu'il y a d'autres mods
        // sous la huitieme ligne.
        if (mods.size() > MAX_ROWS) {
            String more = (scroll > 0 ? "\u25b2 " : "  ")
                    + (scroll + rowsShown) + " / " + mods.size()
                    + (scroll + rowsShown < mods.size() ? " \u25bc" : "");
            context.drawText(textRenderer, Text.literal(more),
                    listX + listW - 6 - textRenderer.getWidth(more),
                    listY + h - ROW_H, 0xFF777777, false);
        }
    }

    private boolean inRow(double mouseX, double mouseY, int rowY) {
        return mouseX >= listX && mouseX < listX + listW
                && mouseY >= rowY && mouseY < rowY + ROW_H;
    }

    /** Coupe un libelle trop long plutot que de le laisser sortir du cadre. */
    private String trim(net.minecraft.client.font.TextRenderer textRenderer, String s, int room) {
        if (room <= 0 || textRenderer.getWidth(s) <= room) return s;
        StringBuilder sb = new StringBuilder();
        for (int i = 0; i < s.length(); i++) {
            if (textRenderer.getWidth(sb.toString() + s.charAt(i) + "\u2026") > room) break;
            sb.append(s.charAt(i));
        }
        return sb + "\u2026";
    }

    // -------------------------------------------------------------- clics

    /**
     * @return true si le clic a ete consomme.
     */
    public boolean click(double mouseX, double mouseY) {
        if (mouseX >= btnX && mouseX < btnX + btnW
                && mouseY >= btnY && mouseY < btnY + BUTTON_H) {
            open = !open;
            return true;
        }
        if (!open) return false;

        int rowY = listY + PAD;
        if (inRow(mouseX, mouseY, rowY)) {
            selectedMods.clear();
            return true;
        }
        rowY += ROW_H;
        for (int i = 0; i < rowsShown; i++) {
            if (inRow(mouseX, mouseY, rowY)) {
                Entry entry = mods.get(scroll + i);
                if (!selectedMods.remove(entry.key)) selectedMods.add(entry.key);
                return true;
            }
            rowY += ROW_H;
        }
        // Un clic dans le cadre mais sur aucune ligne est quand meme consomme :
        // sinon il traverserait et selectionnerait un item derriere.
        return mouseX >= listX && mouseX < listX + listW
                && mouseY >= listY && mouseY < listY + expandedHeight();
    }

    /** Molette au-dessus du panneau deroulant. */
    public boolean scroll(double mouseX, double mouseY, double amount) {
        if (!open || mods.size() <= MAX_ROWS) return false;
        if (mouseX < listX || mouseX >= listX + listW) return false;
        if (mouseY < listY || mouseY >= listY + expandedHeight()) return false;
        scroll = Math.max(0, Math.min(mods.size() - MAX_ROWS,
                scroll - (int) Math.signum(amount)));
        return true;
    }

    public boolean isOpen() {
        return open;
    }
}
